#!/usr/bin/env bash

root_path=$(realpath .)
message_att_path="file://${root_path}/send-message.json"
QUEUE_URL=https://sqs.us-east-1.amazonaws.com/029179923921/sqs-fifo-MyQueue-ILNpH7C4abXb.fifo
echo "== send"

aws sqs send-message --queue-url $QUEUE_URL --message-body "hello mars" --message-group-id "hello" --message-deduplication-id 1 --message-attributes $message_att_path

aws sqs send-message --queue-url $QUEUE_URL --message-body "hello 2" --message-group-id "hello" --message-deduplication-id 2 --message-attributes $message_att_path

aws sqs send-message --queue-url $QUEUE_URL --message-body "hello 3" --message-group-id "hello" --message-deduplication-id 3 --message-attributes $message_att_path

aws sqs send-message --queue-url $QUEUE_URL --message-body "hello 4" --message-group-id "hello" --message-deduplication-id 4 --message-attributes $message_att_path

aws sqs send-message --queue-url $QUEUE_URL --message-body "hello 5!" --message-group-id "hello" --message-deduplication-id 5 --message-attributes $message_att_path

