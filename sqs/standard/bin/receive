#!/usr/bin/env bash

root_path=$(realpath .)
message_att_path="file://${root_path}/send-message.json"
QUEUE_URL=https://sqs.us-east-1.amazonaws.com/029179923921/sqs-standard-MyQueue-ecf53IkqBksM
echo "== receive"

aws sqs receive-message --queue-url $QUEUE_URL --attribute-names All --message-attribute-names All --max-number-of-messages 10
